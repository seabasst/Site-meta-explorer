// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  name               String?
  image              String?
  stripeCustomerId   String?  @unique
  subscriptionStatus String   @default("free") // free, pro, past_due, cancelled
  subscriptionId     String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  ownBrand    TrackedBrand?  @relation("OwnBrand")
  competitors TrackedBrand[] @relation("Competitors")
  snapshots   BrandSnapshot[]
  benchmarks  BenchmarkReport[]
  savedAds        SavedAd[]
  monitoredBrands MonitoredBrand[]
}

model SavedAd {
  id     String @id @default(cuid())
  userId String
  adId   String // references AdLibraryAd.id

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  ad   AdLibraryAd  @relation(fields: [adId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, adId])
  @@index([userId, createdAt])
}

model MonitoredBrand {
  id      String @id @default(cuid())
  userId  String
  brandId String // references AdLibraryBrand.id

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  brand AdLibraryBrand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, brandId])
  @@index([userId, createdAt])
}

model TrackedBrand {
  id             String   @id @default(cuid())
  facebookPageId String
  pageName       String
  adLibraryUrl   String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Owner relation (1:1) — this is the user's own brand
  ownerId String? @unique
  owner   User?   @relation("OwnBrand", fields: [ownerId], references: [id], onDelete: Cascade)

  // Tracker relation (1:many) — this is a competitor being tracked
  trackerId String?
  tracker   User?   @relation("Competitors", fields: [trackerId], references: [id], onDelete: Cascade)

  snapshots BrandSnapshot[]

  @@unique([trackerId, facebookPageId])
}

model BrandSnapshot {
  id             String   @id @default(cuid())
  snapshotDate   DateTime @default(now())
  createdAt      DateTime @default(now())

  // Scalar metrics
  totalAdsFound    Int
  activeAdsCount   Int
  totalReach       BigInt
  avgReachPerAd    Float
  estimatedSpendUsd Float
  videoCount       Int
  imageCount       Int
  carouselCount    Int       @default(0)
  videoPercentage  Float
  imagePercentage  Float
  carouselPercentage Float   @default(0)
  avgAdAgeDays     Float
  dominantGender   String?
  dominantGenderPct Float?
  dominantAgeRange String?
  dominantAgePct   Float?

  // Top 3 countries
  topCountry1Code String?
  topCountry1Pct  Float?
  topCountry2Code String?
  topCountry2Pct  Float?
  topCountry3Code String?
  topCountry3Pct  Float?

  // JSON fields for full breakdowns
  demographicsJson   Json?
  spendByCountryJson Json?

  // Relations
  trackedBrandId String
  trackedBrand   TrackedBrand @relation(fields: [trackedBrandId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  hookGroups HookGroup[]

  @@index([trackedBrandId, snapshotDate])
}

model HookGroup {
  id             String   @id @default(cuid())
  hookText       String   // Original text of the hook (first occurrence)
  normalizedText String   // Normalized version used for grouping
  frequency      Int      // Number of ads with this hook
  totalReach     BigInt   // Sum of euTotalReach across all ads
  avgReachPerAd  Float    // totalReach / frequency
  adIds          Json     // Array of ad IDs in this group (string[])
  createdAt      DateTime @default(now())

  // Relations
  snapshotId     String
  snapshot       BrandSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([snapshotId])
  @@index([snapshotId, totalReach])
}

model BenchmarkReport {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Owner
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Brands in this benchmark (1 baseline + up to 5 competitors)
  brands BenchmarkBrand[]
}

model BenchmarkBrand {
  id             String   @id @default(cuid())
  facebookPageId String
  pageName       String
  adLibraryUrl   String
  isBaseline     Boolean  @default(false) // Exactly one per report must be true
  addedAt        DateTime @default(now())

  // Aggregated snapshot data (same fields as BrandSnapshot)
  totalAdsFound      Int?
  activeAdsCount     Int?
  totalReach         BigInt?
  avgReachPerAd      Float?
  estimatedSpendUsd  Float?
  videoPercentage    Float?
  imagePercentage    Float?
  carouselPercentage Float?
  dominantGender     String?
  dominantAgeRange   String?
  demographicsJson   Json?

  // Relations
  benchmarkId String
  benchmark   BenchmarkReport @relation(fields: [benchmarkId], references: [id], onDelete: Cascade)

  @@unique([benchmarkId, facebookPageId])
  @@index([benchmarkId])
}

// =============================================================================
// v5.0 Meta Ad Library Pipeline
// =============================================================================

model AdLibraryBrand {
  id            String   @id @default(cuid())
  pageId        String   @unique // Facebook Page ID
  pageName      String
  profilePicUrl String?
  country       String?  // Primary country code (DE, GB, etc.)
  category      String?  // Business category (fashion, electronics, etc.)
  website       String?  // Brand website URL

  // Discovery metadata
  totalReach      BigInt   @default(0) // Total EU reach at discovery
  activeAdCount   Int      @default(0) // Active ads at last check
  lastCheckedAt   DateTime?

  // Ingestion control
  ingestionStatus String   @default("pending") // pending, active, paused, failed
  priority        Int      @default(0)         // Higher = process first
  failCount       Int      @default(0)         // Number of consecutive failures (paused at 3+)

  // Aggregated demographics (stored as JSON for flexibility)
  demographicsJson     Json?     // Full AggregatedDemographics object
  demographicsUpdatedAt DateTime? // When demographics were last fetched

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ads            AdLibraryAd[]
  ingestionJobs  IngestionJob[]
  monitoredBy    MonitoredBrand[]
  templates      AdTemplate[]
  sovSnapshots   SovSnapshot[]

  @@index([ingestionStatus, priority])
  @@index([category])
}

model AdLibraryAd {
  id   String @id @default(cuid())
  adId String @unique // Meta's ad_id

  // Brand relation
  brandId String
  brand   AdLibraryBrand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  // Creative content
  displayFormat      String?  // image, video, carousel, dpa
  publisherPlatforms String[] // facebook, instagram, messenger, audience_network
  body               String?  // Primary ad copy (ad_creative_body)
  caption            String?  // Link caption
  title              String?  // Link title
  linkDescription    String?  // Link description
  linkUrl            String?  // Destination URL
  ctaText            String?  // Call-to-action text
  ctaType            String?  // Call-to-action type (SHOP_NOW, LEARN_MORE, etc.)
  snapshotUrl        String?  // Meta's ad_snapshot_url

  // Dates
  startDate      DateTime?
  endDate        DateTime?
  adDurationDays Int?
  isActive       Boolean   @default(true)

  // Performance estimates (if available from API)
  reachEstimate    Int?
  impressionsLower Int?
  impressionsUpper Int?
  spendLower       Float?
  spendUpper       Float?
  currency         String?

  // Targeting (from demographic_distribution if available)
  targetingJson Json? // Full targeting data

  // Ingestion tracking
  ingestionJobId String?
  ingestionJob   IngestionJob? @relation(fields: [ingestionJobId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assets   AdAsset[]
  savedBy  SavedAd[]
  analysis AdAnalysis?

  @@index([brandId, isActive])
  @@index([brandId, startDate])
  @@index([displayFormat])
}

model AdAsset {
  id String @id @default(cuid())

  // Ad relation
  adId String
  ad   AdLibraryAd @relation(fields: [adId], references: [id], onDelete: Cascade)

  // Asset type
  assetType   String  // image, video, thumbnail
  position    Int     @default(0) // Order in carousel (0 for single assets)

  // Original source
  originalUrl String // Meta CDN URL

  // Our storage
  storedUrl     String? // Our CDN URL (after download)
  storedKey     String? // S3/R2 object key
  thumbnailUrl  String? // Generated thumbnail URL
  thumbnailKey  String? // S3/R2 key for thumbnail

  // File metadata
  fileExtension String?
  fileSizeBytes Int?
  width         Int?
  height        Int?
  durationMs    Int?    // For videos

  // Status
  downloadStatus String @default("pending") // pending, downloading, completed, failed
  downloadError  String?

  createdAt DateTime @default(now())

  @@index([adId])
  @@index([downloadStatus])
}

model IngestionJob {
  id String @id @default(cuid())

  // Brand relation
  brandId String
  brand   AdLibraryBrand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  // Job type
  jobType String @default("full") // full, incremental, assets_only

  // Status tracking
  status           String   @default("queued") // queued, running, completed, failed, cancelled
  adsFetched       Int      @default(0)
  adsCreated       Int      @default(0)
  adsUpdated       Int      @default(0)
  assetsQueued     Int      @default(0)
  assetsDownloaded Int      @default(0)
  assetsFailed     Int      @default(0)

  // Error tracking
  errorMessage String?
  errorsJson   Json?   // Array of detailed error objects

  // Timing
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  ads AdLibraryAd[]

  @@index([brandId, status])
  @@index([status, createdAt])
}

// =============================================================================
// Share of Voice Timeline
// =============================================================================

model SovSnapshot {
  id        String   @id @default(cuid())
  brandId   String
  brand     AdLibraryBrand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  // Snapshot date (normalized to week start — Monday)
  weekStart DateTime

  // Metrics at this point in time
  activeAds    Int     @default(0)
  totalReach   BigInt  @default(0)
  estSpend     Float   @default(0)
  videoCount   Int     @default(0)
  imageCount   Int     @default(0)
  carouselCount Int    @default(0)
  newAdsCount  Int     @default(0) // Ads started this week

  createdAt DateTime @default(now())

  @@unique([brandId, weekStart])
  @@index([weekStart])
  @@index([brandId, weekStart])
}

// =============================================================================
// AI Creative Analysis & Templates
// =============================================================================

model AdAnalysis {
  id    String @id @default(cuid())
  adId  String
  ad    AdLibraryAd @relation(fields: [adId], references: [id], onDelete: Cascade)

  // Analysis results
  headline       String?  // Extracted headline pattern
  messagingAngle String?  // e.g. "price-focused", "emotional", "urgency"
  visualStyle    String?  // e.g. "lifestyle", "product-shot", "UGC"
  colorPalette   String[] // Dominant colors
  ctaStyle       String?  // CTA analysis
  targetAudience String?  // Inferred target audience
  emotionalTone  String?  // e.g. "aspirational", "urgent", "playful"
  fullAnalysis   Json?    // Complete structured analysis from Claude

  // Scoring
  creativityScore Int?    // 1-10
  clarityScore    Int?    // 1-10
  persuasionScore Int?    // 1-10

  createdAt DateTime @default(now())

  @@unique([adId])
  @@index([adId])
}

model AdTemplate {
  id String @id @default(cuid())

  // Source
  category    String?  // Category this template was derived from
  brandId     String?  // Optional: specific brand
  brand       AdLibraryBrand? @relation(fields: [brandId], references: [id])
  sourceAdIds String[] // Ad IDs that inspired this template

  // Template content
  name           String   // e.g. "Destination Dream - Airline Style"
  description    String   // What this template is good for
  messagingAngle String   // price, emotional, urgency, social-proof, etc.
  visualStyle    String   // lifestyle, product, UGC, minimal, etc.

  // Five Pillars of Creative Diversity
  primaryPillar  String?  // format | tone | journey | visual | messenger
  pillarDetails  Json?    // { format, tone, journeyPhase, visualStyle, messenger }

  // Copy framework
  headlineFormula String  // e.g. "Fly to {destination} from ${price}"
  bodyFormula     String  // Template with placeholders
  ctaText         String  // Recommended CTA

  // Visual direction
  colorSuggestions String[] // Recommended colors
  imageryNotes     String   // What kind of imagery to use
  layoutNotes      String   // Layout recommendations

  // Metadata
  formatRecommendation String? // image, video, carousel
  platformNotes        String? // Platform-specific tips

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}

// =============================================================================
// Roadmap & Feature Requests
// =============================================================================

model RoadmapRequest {
  id          String   @id @default(cuid())

  // Request info
  type        String   // "brand" or "feature"
  title       String   // Short title
  description String?  // Details/reason

  // Brand-specific (when type="brand")
  pageUrl     String?  // Facebook page URL
  pageId      String?  // Extracted page ID

  // Status
  status      String   @default("pending") // pending, planned, in_progress, completed, rejected
  adminNotes  String?

  // Submitter
  userId      String
  userEmail   String

  // Engagement
  upvoteCount Int      @default(0)

  // Timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  upvotes     RoadmapUpvote[]

  @@index([type, status])
  @@index([upvoteCount])
}

model RoadmapUpvote {
  id        String   @id @default(cuid())
  requestId String
  userId    String
  createdAt DateTime @default(now())

  request   RoadmapRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, userId]) // One upvote per user per request
  @@index([userId])
}
