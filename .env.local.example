# ============================================
# AUTH CONFIGURATION (required for login)
# ============================================

# Auth.js secret - REQUIRED for JWT encryption
# Generate with: npx auth secret
AUTH_SECRET=

# Google OAuth - REQUIRED for "Sign in with Google"
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create OAuth 2.0 Client ID (Web application)
# 3. Add authorized redirect URI: http://localhost:3000/api/auth/callback/google
# 4. Copy Client ID and Client Secret below
AUTH_GOOGLE_ID=your-google-client-id
AUTH_GOOGLE_SECRET=your-google-client-secret

# Email/Password authentication uses a shared demo user (demo@example.com / demo123).
# It is on in `next dev` and off in production builds unless this is set:
# ENABLE_DEMO_LOGIN=1

# ============================================
# FACEBOOK API (already configured)
# ============================================

# ============================================
# TIKTOK COMMERCIAL CONTENT API (EU ad library)
# ============================================
# From developers.tiktok.com/research/ once the application is approved
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
